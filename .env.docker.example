APP_NAME=CentralizedEHR
APP_VERSION=1.0.0
DEBUG=false

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/postgres
ETL_DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-for-local-docker-demo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000"]
